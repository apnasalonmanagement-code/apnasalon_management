{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "apnasalon-management",
  "compatibility_date": "2026-09-23",
  "main": "src/index.js",

  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/shop",
      "/shop/*",
      "/"
    ]
  }
}
